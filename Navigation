import asyncio
import logging
import sys
import mini.mini_sdk as MiniSdk
from mini.dns.dns_browser import WiFiDevice
from mini.apis.api_action import MoveRobot, MoveRobotDirection
from mini.apis.api_action import PlayAction

# === SDK Configuration ===
MiniSdk.set_log_level(logging.INFO)
MiniSdk.set_robot_type(MiniSdk.RobotType.EDU)

# === Constants ===
ROBOT_ID = "418"  # Change to your team's robot ID
SEARCH_TIMEOUT = 10
COMMAND_DELAY = 0.8  # Delay between individual steps

# === Simple Predefined Routes ===
# Format: (Direction, Total Steps Required)
ROUTES = {
    "A": [
        (MoveRobotDirection.FORWARD, 3),
        (MoveRobotDirection.LEFTWARD, 2)
    ],
    "B": [
        (MoveRobotDirection.FORWARD, 4),
        (MoveRobotDirection.RIGHTWARD, 1)
    ],
    "C": [
        (MoveRobotDirection.BACKWARD, 2)
    ]
}

class Robot:
    def __init__(self, device: WiFiDevice):
        self.device = device

async def search_device_by_name(serial_number_suffix: str, timeout: int) -> WiFiDevice:
    try:
        result = await MiniSdk.get_device_by_name(serial_number_suffix, timeout)
        print(f"[✓] Found device: {result}")
        return result
    except Exception as e:
        print(f"[X] Error searching for device: {e}")
        return None

async def execute_single_step(direction: MoveRobotDirection):
    """Executes exactly 1 single step in the specified direction."""
    # We explicitly pass step=1 to track individual intervals
    block = MoveRobot(step=1, direction=direction)
    await block.execute()
    await asyncio.sleep(COMMAND_DELAY)

async def play_builtin_action(action_name: str):
    """Plays a built-in animation (like raising hands)."""
    block = PlayAction(action_name=action_name)
    await block.execute()

async def execute_route_with_tracking(route_key: str):
    """
    Fetches a route and executes it while managing step counts
    one-by-one, mirroring the logic in your flowchart.
    """
    route = ROUTES.get(route_key)
    if not route:
        print(f"[X] Route {route_key} not found.")
        return

    print(f"\n[!] Starting Route {route_key}...")

    # Loop through each leg/segment of the route
    for direction, total_steps in route:
        remaining_steps = total_steps
        print(f"\n--- New Segment: Moving {direction.name} | Total Steps: {total_steps} ---")

        # Flowchart Decision Loop: Is remaining steps > 0?
        while remaining_steps > 0:
            print(f"[Tracking] Remaining steps in this direction: {remaining_steps}")

            # 1. Execute 1 step
            print(f" -> AlphaMini takes 1 step {direction.name}...")
            await execute_single_step(direction)

            # 2. Decrement step count
            remaining_steps -= 1

            # NOTE FOR TEAM: If you implement obstacle detection,
            # you would insert the conditional check right here!
            # e.g., if obstacle_detected(): break

        print(f"[✓] Segment segment finished. Remaining steps is now {remaining_steps}.")

    print(f"\n[✓][✓] Entire Route {route_key} has been completed successfully!\n")

async def control_loop():
    """Handles keyboard inputs to select routes or actions."""
    while True:
        print("=== AlphaMini Navigation Menu ===")
        print("A - Route A (Forward 3 steps -> Left 2 steps)")
        print("B - Route B (Forward 4 steps -> Right 1 step)")
        print("C - Route C (Backward 2 steps)")
        print("R - Raise Hands")
        print("Q - Quit Program")

        choice = input("Enter selection: ").strip().upper()

        if choice in ["A", "B", "C"]:
            # Triggers the sequential tracking function
            await execute_route_with_tracking(choice)
        elif choice == "R":
            print("\n[!] Playing Action...")
            await play_builtin_action("021")
        elif choice == "Q":
            print("\nExiting control loop...")
            break
        else:
            print("\n[X] Invalid selection. Please try again.\n")

async def main():
    device = await search_device_by_name(ROBOT_ID, SEARCH_TIMEOUT)
    if not device:
        print("[Error] No robot found. Check Wi-Fi/Robot ID.")
        return

    connected = await MiniSdk.connect(device)
    if not connected:
        print("[X] Connection failed.")
        return

    print(f"[✓] Connected to {device.name}")

    try:
        await MiniSdk.enter_program()
        print("[✓] Entered programming mode.")

        # Run our flowchart-aligned loop
        await control_loop()

    except Exception as e:
        print(f"[X] An error occurred: {e}")
    finally:
        print("\nShutting down SDK...")
        await MiniSdk.quit_program()
        await MiniSdk.release()
        print("[✓] Shutdown complete.")

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\nProgram interrupted by user. Exiting safely.")
        sys.exit(0)
